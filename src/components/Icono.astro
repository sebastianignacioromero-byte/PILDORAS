---
import { ICONOS, type NombreIcono } from '../lib/iconos';

interface Props {
  nombre: NombreIcono;
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---
<span class:list={['icono', clase]} set:html={ICONOS[nombre]} />

<style>
  .icono { display: inline-flex; line-height: 0; }
</style>
