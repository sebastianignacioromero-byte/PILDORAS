---
// Íconos de la maqueta C. Siempre decorativos: el texto acompañante da el significado.
interface Props {
  nombre: 'ok' | 'alerta' | 'tachado' | 'buscar' | 'chat' | 'escudo';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={clase}>
  {nombre === 'ok' && <path stroke-width="3" d="M5 12.5l4.5 4.5L19 7.5" />}
  {nombre === 'alerta' && (
    <>
      <path stroke-width="3" d="M12 5v9" />
      <circle cx="12" cy="19" r="1.4" fill="currentColor" stroke="none" />
    </>
  )}
  {nombre === 'tachado' && (
    <>
      <circle stroke-width="2.6" cx="12" cy="12" r="8.5" />
      <path stroke-width="2.6" d="M6 18L18 6" />
    </>
  )}
  {nombre === 'buscar' && (
    <>
      <circle stroke-width="2.4" cx="10.5" cy="10.5" r="6.5" />
      <path stroke-width="2.4" d="M16 16l4.5 4.5" />
    </>
  )}
  {nombre === 'chat' && <path stroke-width="2.2" d="M4 19l1.4-4A7.5 7.5 0 1 1 9 18.6z" />}
  {nombre === 'escudo' && (
    <>
      <path stroke-width="2" d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
      <path stroke-width="2" d="M9 12l2 2 4-4" />
    </>
  )}
</svg>
