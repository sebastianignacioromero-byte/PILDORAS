---
import '../styles/global.css';
import { CURIE_COMUNA, CURIE_NOMBRE, CURIE_URL, QF_NOMBRE, QF_TITULO } from '../config';
import { esEjemplo } from '../lib/datos';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  jsonld?: object;
  /** "lectura" limita el ancho para páginas de texto corrido. */
  ancho?: 'completo' | 'lectura';
}
const { titulo, descripcion, noindex = false, jsonld, ancho = 'completo' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const tituloCompleto = titulo === 'Píldoras' ? `Píldoras · ¿Se puede partir este comprimido?` : `${titulo} · Píldoras`;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {(noindex || esEjemplo) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#f3f7f6" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta property="og:image" content={new URL(url('/og.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Píldoras" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {
      esEjemplo && (
        <p class="franja-ejemplo" role="note">
          Datos de ejemplo: los medicamentos de este sitio son ficticios y sirven solo para revisar el diseño.
        </p>
      )
    }
    <header class="cabecera contenedor">
      <a class="marca" href={url('/')}>
        <img src={url('/logo.svg')} alt="" width="44" height="44" />
        Píldoras
      </a>
      <span class="firma">Un proyecto de {CURIE_NOMBRE}<br />{QF_TITULO} {QF_NOMBRE}</span>
    </header>
    <main id="contenido" class="contenedor principal">
      <div class:list={['pila', { lectura: ancho === 'lectura' }]}>
        <slot />
      </div>
    </main>
    <footer class="pie">
      <div class="contenedor pila">
        <nav aria-label="Pie de página">
          <ul>
            <li><a href={url('/dci/')}>Principios activos</a></li>
            <li><a href={url('/criterios/')}>Criterios</a></li>
            <li><a href={url('/sobre-el-proyecto/')}>Sobre el proyecto</a></li>
            <li><a href={url('/contacto/')}>Contacto</a></li>
            <li><a href={url('/aviso-legal/')}>Aviso legal</a></li>
            <li><a href={url('/privacidad/')}>Privacidad</a></li>
          </ul>
        </nav>
        <p>Píldoras · Un proyecto de <a href={CURIE_URL} rel="noopener">{CURIE_NOMBRE}</a>, {CURIE_COMUNA}. Revisado por {QF_TITULO} {QF_NOMBRE}.</p>
        <p>Información de apoyo. No reemplaza la indicación de su médico o químico farmacéutico.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
    top: 8px;
    background: var(--tinta);
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    z-index: 10;
  }
  .saltar:focus { left: 8px; }
  .franja-ejemplo {
    background: #fff4d6;
    color: #5a4200;
    font-size: 0.85rem;
    text-align: center;
    padding: 8px 16px;
    font-weight: 700;
  }
  .cabecera {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: #0e4d64;
    text-decoration: none;
  }
  .marca img { width: 44px; height: 44px; }
  .firma { font-size: 0.8rem; color: #4a6461; text-align: right; line-height: 1.25; }
  .principal { padding-bottom: 48px; }
  @media (min-width: 960px) { .principal { padding-top: 12px; padding-bottom: 72px; } }
  .pie {
    background: var(--alveolo);
    color: var(--apagado);
    font-size: 0.85rem;
    padding: 24px 0 32px;
  }
  .pie ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
</style>
